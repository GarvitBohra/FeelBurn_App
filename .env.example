# FeelBurn App - Firebase Environment Configuration Example
# Copy this file to a new file named '.env' and fill in your actual Firebase Web Config credentials.
# Note: Variables must be prefixed with EXPO_PUBLIC_ to be exposed to client-side code in Expo.

EXPO_PUBLIC_FIREBASE_API_KEY=PLACEHOLDER_API_KEY
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=feelburn-app.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=feelburn-app
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=feelburn-app.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456789
